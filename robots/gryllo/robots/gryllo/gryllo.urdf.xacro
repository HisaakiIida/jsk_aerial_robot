<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="gryllo" >

  <xacro:include filename="$(find gryllo)/urdf/gryllo/gryllo.urdf.xacro" />
  <xacro:include filename="$(find gryllo)/urdf/gryllo/common.xacro" />

  <!-- rotor macro -->
  <xacro:gryllo_center_link child1="1" child2="2" child3="3" child4="4"/>
  <xacro:gryllo_thrust_link self="1" rotor_direction="-1"/>
  <xacro:gryllo_thrust_link self="2" rotor_direction="1"/>
  <xacro:gryllo_thrust_link self="3" rotor_direction="-1"/>
  <xacro:gryllo_thrust_link self="4" rotor_direction="1"/>

  <!-- gryllo spine macro -->
  <xacro:property name="N" value="5"/>
  <xacro:property name="pitch" value="0.0605"/>
</robot>
